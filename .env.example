# Copy this file to .env and fill in real values locally.
# Never commit .env — it is git-ignored on purpose.

# Supabase (client-safe: URL + publishable/anon key, protected by RLS)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-only — bypasses RLS, never expose to client code)
SUPABASE_SERVICE_ROLE_KEY=

# Meta (Facebook) OAuth (server-only)
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
